# A GitHub personal access token (no scopes needed for public data).
# Without it the server falls back to the REST API (60 requests/hour).
GITHUB_TOKEN=

# Optional extra tokens for a busy public instance, separated by commas.
# Requests are spread across all tokens and fail over when one is rate limited.
GITHUB_TOKENS=

# Optional comma separated allowlist, useful for personal deployments.
ALLOWED_USERNAMES=
